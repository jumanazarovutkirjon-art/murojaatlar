      "name": "AI Agent"
    },
    {
      "parameters": {
        "jsCode": "// 1. Забираем сырой текст из AI Agent\nlet text =\n  $json.output ??\n  $json.text ??\n  $json.message?.content ??\n  $json.message?.text ??\n  \"\";\n\n// 2. Защита от объектов (если ИИ вернул JSON вместо строки)\nif (typeof text === 'object' && text !== null) {\n  text = JSON.stringify(text, null, 2);\n} else {\n  text = String(text).trim();\n}\n\n// 3. Защита от пустоты\nif (!text) {\n  text = \"Бот вернул пустое сообщение.\";\n}\n\n// 4. Очистка от ВСЕХ скрытых символов разметки Markdown,\n// которые ИИ обожает ставить (точки в списках, дефисы, звездочки)\ntext = text.replace(/[_*\\[\\]()~`>#+\\-=|{}.!]/g, \"\");\n\n// 5. Защита от слишком длинных ответов ИИ (лимит Telegram — 4096)\nif (text.length > 4000) {\n  text = text.substring(0, 4000) + \"\\n...[Текст обрезан из-за лимита длины]\";\n}\n\n// 6. Передаем чистый текст дальше в узел Telegram\nreturn [{\n  json: {\n    text: text\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
